# Server Configuration
PORT=3001
NODE_ENV=development

# Email Configuration (Gmail)
# Get app password from: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-char-app-password

# CORS Configuration
# For production deployment (GitHub Pages)
ALLOWED_ORIGIN=https://your-username.github.io

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Enable rate limiting in development
# AI Configuration
# Default is http://localhost:11434. Set this if your Ollama is on another machine (e.g. MacBook).
OLLAMA_HOST=http://localhost:11434

# Cloudflare Workers AI (alternative to Ollama) needs NO env var here — it's configured
# entirely client-side (own API token entered in Налаштування, or the public Worker by
# default). See cloudflare-worker/README.md for deploying the public Worker.
