# Email Configuration for Frontend (Vite)
# Get app password from: https://myaccount.google.com/apppasswords
VITE_EMAIL_USER=your-email@gmail.com
VITE_DESTINATION_EMAIL_USER=your-email@gmail.com
VITE_EMAIL_PASS=your-16-char-app-password

# Backend Configuration
PORT=3001
NODE_ENV=development

# Production Configuration (for deployment)
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASS=your-16-char-app-password
# AI Configuration (Ollama)
# Set this to your MacBook's IP if running Ollama there (e.g., http://192.168.0.241:11434)
OLLAMA_HOST=http://localhost:11434
# VITE_AI_BACKEND_URL=http://192.168.0.241:8000

# Cloudflare Workers AI (alternative to Ollama) needs NO env var here — it's configured
# entirely client-side (own API token entered in Налаштування, or the public Worker by
# default). See cloudflare-worker/README.md for deploying the public Worker.
